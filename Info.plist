<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 允许通过 Finder / 文件 App 直接访问本 App 的 Documents 目录，用于单独更新 tdx.db -->
	<key>UIFileSharingEnabled</key>
	<true/>

	<!-- 局域网直连通道：电脑端部署助手经同一 Wi-Fi 向本机推送增量行情库（tdx_live.db）。
	     云端拉取源（raw.githubusercontent / jsDelivr）均为 https，按 ATS 无需任何例外 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>用于与电脑在同一局域网内直连推送行情数据</string>

	<!-- ================= 状态栏 / 全屏（全局唯一配置点） =================
	     本 App 为全屏图表型应用，要求：隐藏系统状态栏 + 不参与 iPad 分屏多任务。
	     两项需求都只在 Info.plist 里配置，不做任何 ViewController / SwiftUI 层级适配，
	     以保证 iPhone / iPad、老新系统版本行为一致。
	     ================================================================= -->

	<!-- ① 启动时即隐藏系统状态栏（app 级设置） -->
	<key>UIStatusBarHidden</key>
	<true/>

	<!-- ② 关闭「由 ViewController 决定状态栏外观」。
	     不关掉的话，UIStatusBarHidden 会被各个 ViewController 的 prefersStatusBarHidden
	     覆盖（SwiftUI 的宿主控制器默认返回 false），iPad 上尤其容易失效 -->
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<!-- ③ 强制全屏：让系统把 App 置于「全屏兼容模式」，退出 iPad 多任务。
	     效果（Apple 官方说明，iPadOS 18 及更早 + 分屏模式已开启的 iPad）：
	       · 场景始终全屏呈现；· 不允许与其他 App 分屏（Split View）；
	       · 不允许用户改变窗口大小；· 不支持「侧拉」（Slide Over）与多窗口。
	     分屏入口被系统整体移除后，顶部中间那个分屏用「···」多任务按钮也就不再出现。
	     注：该键 iPadOS 26 起被标记废弃（26+ 的 Stage Manager/窗口模式下兼容模式不再全屏），
	     但本 App 的目标机型 iPad mini 4（A8）不支持 Stage Manager，不受影响 -->
	<key>UIRequiresFullScreen</key>
	<true/>

	<!-- ④ 声明「从哪个系统版本起允许系统忽略 UIRequiresFullScreen」。
	     给一个远期版本号 = 在新系统上继续保留上面的全屏兼容模式，
	     避免 iPadOS 26/27 上重新冒出窗口控件（该键 iOS/iPadOS 26.2 起才被识别，
	     更老的系统会直接忽略，无副作用） -->
	<key>UIRequiresFullScreenIgnoredStartingWithVersion</key>
	<string>99.0</string>
</dict>
</plist>