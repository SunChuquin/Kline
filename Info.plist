<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 允许通过 Finder / 文件 App 直接访问本 App 的 Documents 目录，用于单独更新 tdx.db -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- iPad 恒横屏第 1 层：兼容模式（iPadOS ≤18 有效，26+ 已废弃、由下面
	     UIApplicationSupportsMultipleScenes=false + AppDelegate 运行时 scene 加固接管）。
	     iPadOS 13+ 默认开启多任务（分屏/滑动整合），此情形下系统会忽略
	     supportedInterfaceOrientationsFor 代理与 UISupportedInterfaceOrientations 声明，
	     强制 App 跟随设备方向 → iPad 竖持时 K 线页被转成竖屏（iPhone 无多任务故不受影响）。 -->
	<key>UIRequiresFullScreen</key>
	<true/>
	<!-- iPad 恒横屏第 2 层：禁用多窗口场景（SwiftUI WindowGroup 默认 true，
	     必须显式关闭；配合 pbxproj 关闭 INFOPLIST_KEY_UIApplicationSceneManifest_Generation
	     避免自动生成的 true 覆盖此处手写值）。 -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
</dict>
</plist>
