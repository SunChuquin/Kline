<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 允许通过 Finder / 文件 App 直接访问本 App 的 Documents 目录，用于单独更新 tdx.db -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- iPad 方向锁定的必要声明：iPadOS 13+ 默认开启多任务（分屏/滑动整合），
	     此情形下系统会忽略 supportedInterfaceOrientationsFor 代理与
	     UISupportedInterfaceOrientations 声明，强制 App 跟随设备方向 →
	     iPad 竖持时 K 线页被转成竖屏（iPhone 无多任务故不受影响）。
	     声明本键后 iPad 仅全屏运行，方向锁定对 iPad 与 iPhone 一致生效。
	     代价：iPad 失去分屏/滑动整合多任务（金融图表类 App 常规取舍）。 -->
	<key>UIRequiresFullScreen</key>
	<true/>
</dict>
</plist>
