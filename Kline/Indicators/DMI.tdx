NAME=DMI
SCOPE=sub
GROUP=趋向
FORMULA:
TR1:=MAX(MAX(H-L,ABS(H-REF(C,1))),ABS(L-REF(C,1)));
HD:=H-REF(H,1);
LD:=REF(L,1)-L;
PDM:=IF(HD>0 AND HD>LD,HD,0);
MDM:=IF(LD>0 AND LD>HD,LD,0);
PDI:SUM(PDM,14)/SUM(TR1,14)*100;
MDI:SUM(MDM,14)/SUM(TR1,14)*100;
ADX:MA(ABS(MDI-PDI)/(MDI+PDI)*100,6);
ADXR:(ADX+REF(ADX,6))/2;
