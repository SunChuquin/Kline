NAME=DMI
SCOPE=sub
GROUP=趋向
FORMULA:
N:=14;
M:=6;
MTR:=SUM(MAX(MAX(HIGH-LOW,ABS(HIGH-REF(CLOSE,1))),ABS(REF(CLOSE,1)-LOW)),N);
HD :=HIGH-REF(HIGH,1);
LD :=REF(LOW,1)-LOW;
DMP:=SUM(IF(HD>0&&HD>LD,HD,0),N);
DMM:=SUM(IF(LD>0&&LD>HD,LD,0),N);
PI: DMP*100/MTR;
MI: DMM*100/MTR;
X: MA(ABS(MI-PI)/(MI+PI)*100,M);
XR:(X+REF(X,M))/2;
