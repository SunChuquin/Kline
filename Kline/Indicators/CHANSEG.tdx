NAME=缠论段中枢
SCOPE=main
FORMULA:
NOTEXT_SEG:CHANSEG,LINETHICK2,COLORORANGE;
NOTEXT_SUC:CHANSEGUC,COLORLIGRAY,DOTLINE;
NOTEXT_SZG:CHANSEGZG,COLORRED;
NOTEXT_SZD:CHANSEGZD,COLORRED;
NOTEXT_SZGUC:CHANSEGZGUC,COLORLIGRAY,DOTLINE;
NOTEXT_SZDUC:CHANSEGZDUC,COLORLIGRAY,DOTLINE;
STICKLINE(CHANSEGSEAL,CHANSEGZG,CHANSEGZD,0,0),COLORRED;
STICKLINE(CHANSEGSEALUC,CHANSEGZGUC,CHANSEGZDUC,0,0),COLORLIGRAY,DOTLINE;
